// 口コミ・評判スコア詳細モデル
model ReviewScoreDetail {
  id              String    @id @default(cuid())
  clinicId        String
  evaluatedAt     DateTime  @default(now())

  q1GoogleRating  Int       @default(0) // Google評価
  q2GoogleCount   Int       @default(0) // Google口コミ数
  q3ReplyRate     Int       @default(0) // 返信率
  q4ReplySpeed    Int       @default(0) // 返信速度
  q5ReplyQuality  Int       @default(0) // 返信の質
  q6NegativeHandle Int      @default(0) // ネガティブ対応
  q7EparkRating   Int       @default(0) // EPARK評価
  q8PortalRating  Int       @default(0) // ポータル評価
  q9ReviewRequest Int       @default(0) // 口コミ依頼の仕組み
  q10Recency      Int       @default(0) // 最新口コミ

  totalScore      Int       @default(0)
  evaluationData  Json?
  aiAnalysis      String?   @db.Text
  aiSuggestions   Json?
  createdAt       DateTime  @default(now())

  @@index([clinicId])
}

// オフラインスコア詳細モデル
model OfflineScoreDetail {
  id              String    @id @default(cuid())
  clinicId        String
  evaluatedAt     DateTime  @default(now())

  q1Signage       Int       @default(0) // 外看板
  q2SignInfo      Int       @default(0) // 看板情報
  q3InternalPoster Int      @default(0) // 院内掲示
  q4AppointmentCard Int     @default(0) // 診察券
  q5Leaflet       Int       @default(0) // リーフレット
  q6ReferralCard  Int       @default(0) // 紹介カード
  q7Reminder      Int       @default(0) // 定期検診リマインド
  q8Newsletter    Int       @default(0) // ニュースレター
  q9LocalEvent    Int       @default(0) // 地域イベント
  q10SchoolCheck  Int       @default(0) // 学校・企業健診

  totalScore      Int       @default(0)
  evaluationData  Json?
  aiAnalysis      String?   @db.Text
  aiSuggestions   Json?
  createdAt       DateTime  @default(now())

  @@index([clinicId])
}
