  evaluatedAt     DateTime  @default(now())

  q1Instagram     Int       @default(0) // Instagram
  q2IgFollowers   Int       @default(0) // IGフォロワー
  q3Line          Int       @default(0) // LINE公式
  q4LineFriends   Int       @default(0) // LINE友だち
  q5Facebook      Int       @default(0) // Facebook
  q6Youtube       Int       @default(0) // YouTube
  q7ContentQuality Int      @default(0) // 投稿の質
  q8Engagement    Int       @default(0) // エンゲージメント
  q9Profile       Int       @default(0) // プロフィール充実度
  q10Integration  Int       @default(0) // SNS間連携

  totalScore      Int       @default(0)
  evaluationData  Json?
  aiAnalysis      String?   @db.Text
  aiSuggestions   Json?
  createdAt       DateTime  @default(now())

